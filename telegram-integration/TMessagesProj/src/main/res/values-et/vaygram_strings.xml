    <string name="vay_onboarding_title">Tere tulemast vayGrami</string>
    <string name="vay_onboarding_body">Telegram jääb tuttavaks. vayGram lisab kohandamiskihi, mida saad avastada omas tempos.</string>
    <string name="vay_onboarding_choose_level">Vali kohandamise tase</string>
    <string name="vay_onboarding_choose_level_body">Seda saab alati muuta. Basic hoiab vaate lihtsana, Advanced näitab rohkem seadeid ja Insane avab kõige sügavama kohandamise.</string>
    <string name="vay_onboarding_scopes_title">Muuda ainult seda, mida päriselt vajad</string>
    <string name="vay_onboarding_scopes_body">Global määrab aluse. Account saab seda muuta. Chat saab mõlemad üle kirjutada. Päritud väärtused jäävad alati nähtavaks.</string>
    <string name="vay_onboarding_preview_title">Vaata tulemust enne kinnitamist</string>
    <string name="vay_onboarding_preview_body">Live preview, Undo/Redo ja presetid on ühes kohas.</string>
