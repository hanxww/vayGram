    <string name="vay_onboarding_replay_hint">Näita Vay Settings juhendit uuesti</string>
    <string name="vay_coach_preview_title">Live preview</string>
    <string name="vay_coach_preview_body">Muudatused ilmuvad siia kohe, et saaksid liidest enne seadete sulgemist hinnata.</string>
    <string name="vay_coach_level_title">Basic, Advanced, Insane</string>
    <string name="vay_coach_level_body">Puuduta seda rida, et näha rohkem või vähem seadeid. Alusta lihtsalt ja ava sügavamad valikud vajadusel.</string>
    <string name="vay_coach_scope_title">Ulatused ja pärimine</string>
    <string name="vay_coach_scope_body">Global on alus. Account ja Chat võivad seda muuta ilma päritud väärtust kaotamata.</string>
    <string name="vay_coach_theme_title">Theme Engine</string>
    <string name="vay_coach_theme_body">Siin asuvad paleti- ja gradiendiredaktorid. Käsitsi määratud värvid on genereeritud värvidest tähtsamad.</string>
    <string name="vay_coach_profiles_title">Profiilid ja presetid</string>
    <string name="vay_coach_profiles_body">Salvesta seadistus, ekspordi see, impordi kellegi teise oma või vaheta hiljem profiile.</string>
    <string name="vay_coach_next">Edasi</string>
    <string name="vay_coach_done">Valmis</string>
    <string name="vay_coach_finished">Valmis. Nüüd saad vayGrami rahulikult omas tempos avastada.</string>

