+    private void vayRefreshMainTabsInsets() {
+        final int nextNavigationHeight = hasMainTabs
+                ? dp(DialogsActivity.MAIN_TABS_HEIGHT_WITH_MARGINS)
+                : 0;
+        final int nextFloatingOffset = hasMainTabs
+                ? dp(DialogsActivity.MAIN_TABS_HEIGHT + DialogsActivity.MAIN_TABS_MARGIN)
+                : 0;
+
+        additionNavigationBarHeight = nextNavigationHeight;
+        additionFloatingButtonOffset = nextFloatingOffset;
+
+        if (bottomButtonsContainer != null) {
+            ViewGroup.MarginLayoutParams lp =
+                    (ViewGroup.MarginLayoutParams) bottomButtonsContainer.getLayoutParams();
+            final int bottomMargin = navigationBarHeight + additionFloatingButtonOffset;
+            if (lp != null && lp.bottomMargin != bottomMargin) {
+                lp.bottomMargin = bottomMargin;
+                bottomButtonsContainer.setLayoutParams(lp);
+            }
+        }
+
+        if (sharedMediaLayout != null) {
+            sharedMediaLayout.setPagesPaddingBottom(
+                    navigationBarHeight + additionNavigationBarHeight
+            );
+            if (sharedMediaLayout.giftsContainer != null) {
+                sharedMediaLayout.giftsContainer.setButtonOffset(
+                        navigationBarHeight + additionFloatingButtonOffset
+                );
+            }
+        }
+
+        if (listView != null) {
+            listView.requestLayout();
+        }
+    }
+
+    @NonNull
+    private WindowInsetsCompat onApplyWindowInsets(@NonNull View v, @NonNull WindowInsetsCompat insets) {
+        navigationBarHeight = insets.getInsets(WindowInsetsCompat.Type.systemBars()).bottom;
+        vayRefreshMainTabsInsets();
+        return WindowInsetsCompat.CONSUMED;
+    }
 
